{
  "job": {
    "content": [
      {
        "reader": {
          "name": "dirtydemoreader",
          "parameter": {
            "totalRecords": 10,
            "readerDirtyIndexes": [0],
            "column": ["id", "name"]
          }
        },
        "writer": {
          "name": "dirtydemowriter",
          "parameter": {
            "writerDirtyValues": [1],
            "column": ["id", "name"]
          }
        }
      }
    ],
    "setting": {
      "speed": {
        "channel": 1
      },
      "errorLimit": {
        "record": 0
      },
      "dirtyRecord": {
        "enable": true,
        "path": "${SINK_ROOT}",
        "sinkName": "${SINK_NAME}",
        "fileMaxSize": "1MB",
        "totalSizeCap": "10MB"
      }
    }
  }
}
